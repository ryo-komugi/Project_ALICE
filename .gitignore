# ==============================================================================
# Project_ALICE .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Virtual Envs
myenv/
.myenv/
venv/
.venv/
env/
.env/
ENV/
.pyenv/

# Environment Configurations & Secrets
.env
.env.*
!.env.example
*.pem
*token.txt
*credentials*.json
*token*.json
client_secret*.json

# Databases & Runtime SQLite caches
*.db
*.db-journal
*.db-wal
*.db-shm
database/*.db*
database/*.pem

# Testing & Linting Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs & Temporary files
logs/
*.log
tmp/
temp/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db

# Project-Specific Tooling & Archives
.aider*
.codeboarding/
.archive/
archive/
