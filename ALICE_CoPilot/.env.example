# ==============================================================================
# ALICE_CoPilot Environment Configuration Template
# 実際の環境に合わせて値を設定し、このファイルを '.env' にコピーしてください。
# ==============================================================================

# Discord Bot Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Ollama API 接続設定 (Local LLM)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=gemma4:e4b
OLLAMA_CONTEXT=8192
OLLAMA_KEEP_ALIVE=24h

# オーナーユーザー識別子
ALICE_OWNER_CORE_USER_ID=your_owner_user_id_here

# Google カレンダー連携設定 (任意)
GOOGLE_CALENDAR_ID=your_calendar_id@gmail.com
