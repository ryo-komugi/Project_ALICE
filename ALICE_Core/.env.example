# ==============================================================================
# ALICE_Core Environment Configuration Template
# 実際の環境に合わせて値を設定し、このファイルを '.env' にコピーしてください。
# ==============================================================================

# LINE Messaging API 認証設定
CHANNEL_SECRET=your_line_channel_secret_here
CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 外部公開URL（Cloudflare Tunnel, リバースプロキシなど）
PUBLIC_URL=https://your-domain.example.com

# ユーザー招待コード
INVITE_CODE=change_this_to_your_secret_invite_code

# システム管理者 LINE ユーザーID
LINE_ADMIN_USER=U00000000000000000000000000000000

# 障害・警告通知用 Discord Webhook URL
DISCORD_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your/alert_webhook_here

# 管理画面 WebUI ログイン認証情報
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password
ADMIN_SECRET_KEY=generate_a_random_secret_key_here

# ALICE の永続データルート（省略時は PROJECT_ROOT/data）
# 相対パスは PROJECT_ROOT から解決。全モジュールで同じ値を使用します。
# runtime/workspaces, logs, core/inbox|share|archive 等をこの配下に保存します。
# ALICE_DATA_DIR=data

# 並行 Core インスタンスでは現行版と IP 監視・通知を重複させない
# ALICE_ENABLE_IP_MONITOR=false
